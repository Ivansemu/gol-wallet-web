{
  "name": "gol-wallet-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-shared.mjs",
    "dev": "npm run sync && next dev -p 3000",
    "build": "npm run sync && next build && node scripts/headers.mjs",
    "typecheck": "npm run sync && tsc --noEmit",
    "test": "npm run sync && node --import tsx --test tests/wallet.test.mjs",
    "e2e": "node --test tests/e2e.test.mjs",
    "build:demo": "NEXT_PUBLIC_SUPABASE_URL=https://demo.supabase.co NEXT_PUBLIC_SUPABASE_ANON_KEY=demo-anon NEXT_PUBLIC_OCR_WORKER_URL=https://ocr.demo NEXT_PUBLIC_SITE_URL=http://localhost:4173 npm run build",
    "check:server": "node scripts/check-server.mjs",
    "smoke": "node scripts/smoke.mjs",
    "preview:cf": "wrangler pages dev out --port 8788"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.61.0",
    "next": "^16.0.10",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "^4.151.3"
  }
}
